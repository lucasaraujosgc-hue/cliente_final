# Modelo do android/keystore.properties (o real fica FORA do Git).
# Copie para keystore.properties e preencha. O build.gradle do app lê daqui
# para assinar o release (bundleRelease / Generate Signed App Bundle).
#
# storeFile: relativo à pasta android/. Caminho absoluto no Windows precisa
#   de barras normais ou duplas: C:/chaves/portal-virgula-upload.jks
# PKCS12 (padrão do keytool/Android Studio) exige storePassword == keyPassword.
# Evite \ e espaços nas senhas (arquivo .properties).
storeFile=portal-virgula-upload.jks
storePassword=TROQUE-AQUI
keyAlias=portal
keyPassword=TROQUE-AQUI
