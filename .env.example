# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# POSTGRES DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ADMIN AUTH
# In production the server refuses to boot if these are unset or left at the
# well-known example values below. Use a strong, unique password.
ADMIN="admin"
PASSWORD="admin_password"

# Comma-separated list of browser origins allowed to call the API via CORS.
# Leave empty in local dev (the request origin is reflected). REQUIRED in prod
# — the server refuses to boot without it when NODE_ENV=production.
CORS_ORIGINS="https://cliente.virgulacontabil.com.br"

# Web Push (PWA notifications). Generate once with:
#   npx web-push generate-vapid-keys
# If unset, the server generates ephemeral keys that break on every restart.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Port the HTTP server listens on (Cloud Run injects this, defaults to 3000).
PORT="3000"

# Number of reverse-proxy hops to trust for X-Forwarded-For (rate limiting +
# req.ip). EasyPanel/Traefik and Cloud Run = 1 (the default). Only raise it if
# your infra genuinely adds more (e.g. Cloudflare -> Traefik -> app => 2).
# NEVER set "true" — that lets clients spoof their IP past the rate limiters.
TRUST_PROXY="1"

# Content-Security-Policy is sent by default. Set to "false" only to disable it
# (e.g. while debugging a violation). See the directives in server.ts.
CSP_ENABLED="true"

# AES-256-GCM key for encrypting secrets at rest (SERPRO consumer secret, cert
# passphrase, the .pfx files — SERPRO and per-client NFS-e). DEDICATED key — do
# not reuse JWT_SECRET. openssl rand -base64 32
# If unset, those values are stored as-is (a warning is logged); set it and
# re-save the SERPRO config to encrypt. REQUIRED for NFS-e certificate storage.
SECRETS_KEY=""

# --- NFS-e (Sistema Nacional NFS-e / Sefin Nacional) ------------------------
# Ambiente padrão para novas configurações de cliente: "homologacao"
# (produção restrita) ou "producao".
NFSE_AMBIENTE_DEFAULT="homologacao"
# Bases da API (padrões oficiais — só sobrescreva se o gov.br mudar).
NFSE_SEFIN_BASE_PROD="https://sefin.nfse.gov.br/SefinNacional"
NFSE_SEFIN_BASE_RESTRITA="https://sefin.producaorestrita.nfse.gov.br/SefinNacional"
NFSE_ADN_BASE_PROD="https://adn.nfse.gov.br"
NFSE_ADN_BASE_RESTRITA="https://adn.producaorestrita.nfse.gov.br"
# Onde os certificados A1 de cada cliente são gravados (cifrados). Default:
# DATA_PATH/certs/nfse ou ./data/certs/nfse.
NFSE_CERTS_DIR=""
# Onde os PDFs (DANFSE) ficam em cache. Default: DATA_PATH/nfse_pdfs.
NFSE_PDF_DIR=""
# Consulta de CNPJ do tomador (APIs gratuitas). Só sobrescreva para um mirror.
BRASILAPI_BASE="https://brasilapi.com.br"
RECEITAWS_BASE="https://receitaws.com.br"

# EMAIL SETTINGS (first access)
EMAIL_USER="contato@virgulacontabil.com.br"
EMAIL_ALIAS="cliente@virgulacontabil.com.br"
EMAIL_PASSWORD="email_password"
EMAIL_HOST="smtp.hostinger.com"
EMAIL_PORT="587"
EMAIL_FROM_NAME="Vírgula Contábil"

# JWT Auth Secret — signs the short-lived (15 min) access token. REQUIRED in
# production; the server will not start without a real value. The 90-day
# refresh token is an opaque random string stored hashed in auth_sessions, so
# rotating JWT_SECRET only invalidates access tokens (users refresh silently).
# Generate one with: openssl rand -base64 48
JWT_SECRET="your_long_random_secret_string_here"

# Optional extra secret mixed into password-recovery code hashes. Falls back to
# JWT_SECRET when unset. openssl rand -base64 32
PASSWORD_RESET_PEPPER=""

# Accountant 2FA (email one-time code, second step after username+password).
# ON by default whenever there is an address to send the code to. Set to a
# dedicated address here, or it falls back to EMAIL_USER. Set ACCOUNTANT_2FA=off
# to disable (not recommended in production).
ACCOUNTANT_MFA_EMAIL=""
# ACCOUNTANT_2FA="off"
