# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# POSTGRES DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ADMIN AUTH
# In production the server refuses to boot if these are unset or left at the
# well-known example values below. Use a strong, unique password.
ADMIN="admin"
PASSWORD="admin_password"

# Comma-separated list of browser origins allowed to call the API via CORS.
# Leave empty in local dev (the request origin is reflected). REQUIRED in prod.
CORS_ORIGINS="https://cliente.virgulacontabil.com.br"

# Web Push (PWA notifications). Generate once with:
#   npx web-push generate-vapid-keys
# If unset, the server generates ephemeral keys that break on every restart.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Port the HTTP server listens on (Cloud Run injects this, defaults to 3000).
PORT="3000"

# Set to "true" to send a Content-Security-Policy header (see server.ts).
# Leave off until you've verified the SPA still loads with it on.
CSP_ENABLED="false"

# EMAIL SETTINGS (first access)
EMAIL_USER="contato@virgulacontabil.com.br"
EMAIL_ALIAS="cliente@virgulacontabil.com.br"
EMAIL_PASSWORD="email_password"
EMAIL_HOST="smtp.hostinger.com"
EMAIL_PORT="587"
EMAIL_FROM_NAME="Vírgula Contábil"

# JWT Auth Secret. REQUIRED in production — the server will not start without
# a real value here. Generate one with: openssl rand -base64 48
JWT_SECRET="your_long_random_secret_string_here"

# Optional extra secret mixed into password-recovery code hashes. Falls back to
# JWT_SECRET when unset. openssl rand -base64 32
PASSWORD_RESET_PEPPER=""
